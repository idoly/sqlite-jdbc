FROM rockylinux:8.10@sha256:e8a49c5403b687db05d4d67333fa45808fbe74f36e683cec7abb1f7d0f2338c6

RUN dnf install -y cmake gcc make && dnf clean all

COPY sqlite-native /workspace/sqlite-native
WORKDIR /workspace/sqlite-native

RUN cmake -S . -B /tmp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/sqlite-jdbc \
      -DCMAKE_INSTALL_LIBDIR=lib \
    && cmake --build /tmp/build \
    && cmake --install /tmp/build --strip

CMD ["sh", "-c", "cp -a /opt/sqlite-jdbc/. /output/"]
